{
  "name": "fairteilen",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "Fairteilen.app - freie, quelloffene Alternative zum Teilen von Ausgaben in Gruppen",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "postinstall": "prisma generate",
    "use:postgres": "node scripts/use-postgres.mjs",
    "test": "node --test --experimental-strip-types --conditions=react-server \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
