{
  "name": "fairteilen",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "Fairteilen.app - freie, quelloffene Alternative zum Teilen von Ausgaben in Gruppen",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "setup": "prisma generate && node scripts/db-sync.mjs && next build",
    "doctor": "node scripts/doctor.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --conditions=react-server \"tests/**/*.test.ts\"",
    "i18n": "node --experimental-strip-types --no-warnings scripts/i18n-pruefen.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "db:push": "node scripts/db-sync.mjs",
    "db:push:force": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "use:mysql": "node scripts/use-database.mjs mysql",
    "use:postgres": "node scripts/use-database.mjs postgres",
    "use:sqlite": "node scripts/use-database.mjs sqlite",
    "app:sync": "cap sync",
    "app:ios": "cap open ios",
    "app:android": "cap open android",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
