# Datenbank – SQLite (Standard, keine weitere Einrichtung nötig)
DATABASE_URL="file:./dev.db"

# Für Postgres (z. B. Neon/Supabase/eigener Server):
#   npm run use:postgres
#   DATABASE_URL="postgresql://user:pass@host:5432/fairteilen?sslmode=require"

# Geheimnis zum Signieren der Sitzungs-Cookies (mindestens 32 Zeichen).
# Erzeugen mit: openssl rand -base64 48
AUTH_SECRET="bitte-aendern-mindestens-32-zeichen-lang-geheim"

# Optional: Registrierung schließen (dann nur noch per Einladungslink)
# ALLOW_REGISTRATION="false"

# Öffentliche Basis-URL der Instanz – nötig für Einladungs- und OAuth-Links
# APP_URL="https://fairteilen.example"

# --- Anmeldung mit Google (optional) ---
# Google Cloud Console → APIs & Dienste → Anmeldedaten → OAuth-Client-ID (Webanwendung)
# Autorisierter Redirect-URI: https://DEINE-DOMAIN/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Anmeldung mit Apple (optional) ---
# Apple Developer → Certificates, Identifiers & Profiles
#   APPLE_CLIENT_ID  = die Services-ID (z. B. app.fairteilen.web)
#   APPLE_TEAM_ID    = die Team-ID
#   APPLE_KEY_ID     = die Key-ID des "Sign in with Apple"-Schlüssels
#   APPLE_PRIVATE_KEY= Inhalt der .p8-Datei (Zeilenumbrüche als \n)
# Return-URL: https://DEINE-DOMAIN/api/auth/apple/callback   (nur HTTPS)
# APPLE_CLIENT_ID=""
# APPLE_TEAM_ID=""
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY=""
