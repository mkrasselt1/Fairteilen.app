# Auch im Produktionsmodus die Entwicklungsabhängigkeiten mitinstallieren.
#
# Hintergrund: Setzt die Hosting-Umgebung NODE_ENV=production (bei Plesk der
# Anwendungsmodus), lässt `npm install` sonst devDependencies weg. Ohne
# TypeScript, Tailwind und die Prisma-CLI schlagen aber sowohl `prisma generate`
# im postinstall als auch `npm run build` fehl.
include=dev
