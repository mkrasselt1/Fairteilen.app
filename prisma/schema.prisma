// Fairteilen.app – Datenmodell
// Standard: MySQL / MariaDB. Umstellen mit `npm run use:postgres` bzw.
// `npm run use:sqlite` (SQLite braucht keinen Datenbankserver – praktisch für lokale Arbeit).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  /// Gäste ohne Konto haben keine Adresse – MySQL erlaubt mehrere NULL-Werte
  /// im eindeutigen Index, deshalb bleibt die Eindeutigkeit für echte Konten erhalten.
  email         String?  @unique
  name          String
  /// Optional: Konten, die nur über Google oder Apple angemeldet werden, haben kein Passwort.
  passwordHash  String?
  /// Platzhalter für Personen ohne Konto. Sie können sich nicht anmelden, zählen
  /// aber bei Ausgaben und Salden wie alle anderen mit.
  isGuest       Boolean  @default(false)
  currency      String   @default("EUR")
  locale        String   @default("de")
  avatarColor   String   @default("#2f9e6f")

  /// Zahlungsangaben – nur zur Anzeige beim Begleichen, keine Anbindung an
  /// einen Zahlungsdienst. Sichtbar nur für Personen, mit denen etwas geteilt wird.
  iban          String?
  weroContact   String?
  paypalEmail   String?
  paymentNote   String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions          Session[]
  oauthAccounts     OAuthAccount[]
  memberships       GroupMember[]
  createdGroups     Group[]        @relation("GroupCreator")
  createdExpenses   Expense[]      @relation("ExpenseCreator")
  shares            ExpenseShare[]
  comments          Comment[]
  activities        Activity[]     @relation("ActivityActor")
  attachments       Attachment[]
  friendshipsFrom   Friendship[]   @relation("FriendshipUser")
  friendshipsTo     Friendship[]   @relation("FriendshipFriend")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Einmal-Nonce für die native Anmeldung in der App. Verhindert, dass ein
/// abgefangenes ID-Token ein zweites Mal eingelöst werden kann.
model LoginNonce {
  id        String    @id @default(cuid())
  value     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

/// Verknüpftes Konto bei einem externen Anbieter (Google, Apple).
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String // google | apple
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Direkte Verbindung zwischen zwei Nutzer:innen (beidseitig gespeichert).
model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
}

model Group {
  id            String   @id @default(cuid())
  name          String
  type          String   @default("other") // trip | home | couple | event | project | other
  currency      String   @default("EUR")
  simplifyDebts Boolean  @default(true)
  inviteToken   String   @unique
  /// Ist gesetzt, darf jede Person mit dem Link ohne Konto mitarbeiten.
  publicToken   String?  @unique
  /// Bei Gruppen, die allein über einen Link entstanden sind, ist das ein Gast.
  createdById   String
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy  User          @relation("GroupCreator", fields: [createdById], references: [id])
  members    GroupMember[]
  expenses   Expense[]
  activities Activity[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member") // owner | member
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Expense {
  id          String   @id @default(cuid())
  groupId     String?
  description String
  amountCents Int
  currency    String   @default("EUR")
  date        DateTime @default(now())
  category    String   @default("general")
  notes       String? @db.Text
  splitType   String   @default("equal") // equal | exact | percent | shares | adjustment
  isPayment   Boolean  @default(false)
  createdById String
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recurrence      String?   // none | daily | weekly | monthly | yearly
  recurrenceUntil DateTime?
  nextOccurrence  DateTime?
  recurringFromId String?

  group     Group?         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User           @relation("ExpenseCreator", fields: [createdById], references: [id])
  shares      ExpenseShare[]
  comments    Comment[]
  activities  Activity[]
  attachments Attachment[]

  @@index([groupId])
  @@index([date])
}

/// Ein Datensatz pro beteiligter Person und Ausgabe:
/// paidCents = tatsächlich bezahlt, oweCents = rechnerischer Anteil.
model ExpenseShare {
  id        String @id @default(cuid())
  expenseId String
  userId    String
  paidCents Int    @default(0)
  oweCents  Int    @default(0)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
}

/// Beleg zu einer Ausgabe – Foto oder PDF. Die Datei liegt außerhalb des
/// Web-Verzeichnisses und wird nur über eine geprüfte Route ausgeliefert.
model Attachment {
  id           String   @id @default(cuid())
  expenseId    String
  uploadedById String
  /// Dateiname auf der Platte, zufällig vergeben.
  storedName   String
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model Comment {
  id        String   @id @default(cuid())
  expenseId String
  userId    String
  body      String @db.Text
  createdAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model Activity {
  id        String   @id @default(cuid())
  type      String // expense_added | expense_updated | expense_deleted | payment_added |
                   // group_created | member_joined | member_left | comment_added
  actorId   String
  groupId   String?
  expenseId String?
  payload   String   @default("{}") @db.Text
  createdAt DateTime @default(now())

  actor   User     @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  group   Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([groupId])
}
